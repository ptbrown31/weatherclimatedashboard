# Copy to ops/aws/deploy.env (gitignored) and fill in. No credentials go here;
# the AWS CLI's own sign-in is used.

# Stack and region (CloudFront certificates must live in us-east-1)
STACK=weather-tools-site
REGION=us-east-1

# Sent to every government endpoint; api.weather.gov returns 403 without a contact
USER_AGENT="weather-tools-site/0.1 (you@example.com)"

# Optional custom domain and its ACM certificate ARN (us-east-1); leave both empty to
# run on the CloudFront hostname
DOMAIN=
CERT_ARN=

# How the daily traffic report and the health alarms are delivered.
#
# Preferred: SMTP from your own mail account to your own address. Nothing to
# confirm, nothing to unsubscribe, and it reaches an inbox. SMTP_PASSWORD is an
# APP password, never the account password; append it to the gitignored
# ops/aws/deploy.env yourself or export it in the shell. Leaving SMTP_USER empty
# falls back to the SNS topic below.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_TO=

# Fallback: an SNS topic. Its confirmation email must be clicked, and its
# unsubscribe link needs no authentication, so a mail provider that crawls URLs
# to check them can silence the topic by fetching one. Both subscriptions here
# died that way before the SMTP lane existed.
ALARM_EMAIL=

# Vendor lane (optional): the live-storm wind-probability API. The base URL is plain
# config; the key is a credential: append it to this gitignored file yourself
# (REASK_API_KEY=...) or export it in the shell before running the vendor phase.
REASK_BASE_URL=
REASK_API_KEY=

# Seed phase: a local copy of an existing archive ({STATION}/hourly_*.json.gz ...) and the
# first UTC day to backfill observations from (at most 30 days ago)
ARCHIVE_SRC=
BACKFILL_FROM=2026-08-13
